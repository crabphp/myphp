// phpsdl: SDL3 window and input, SDL_GPU drawing, canvas paths, textures, buffers and audio for myphp.

ARG_ENABLE("phpsdl", "Enable phpsdl (needs SDL3)", "no");

if (PHP_PHPSDL != "no") {
    if (CHECK_HEADER_ADD_INCLUDE("SDL3/SDL.h", "CFLAGS_PHPSDL", PHP_PHPSDL + "\\include;" + PHP_PHP_BUILD + "\\include") &&
        CHECK_HEADER_ADD_INCLUDE("hb-raster.h", "CFLAGS_PHPSDL", PHP_PHPSDL + "\\include\\harfbuzz;" + PHP_PHP_BUILD + "\\include\\harfbuzz") &&
        (CHECK_LIB("SDL3-static.lib", "phpsdl", PHP_PHPSDL) || CHECK_LIB("SDL3.lib", "phpsdl", PHP_PHPSDL)) &&
        CHECK_LIB("harfbuzz-raster.lib", "phpsdl", PHP_PHPSDL) && CHECK_LIB("harfbuzz.lib", "phpsdl", PHP_PHPSDL)) {
        // SDL3's own system dependencies when linked statically.
        var libs = ["user32.lib", "gdi32.lib", "winmm.lib", "imm32.lib", "ole32.lib", "oleaut32.lib", "version.lib",
            "uuid.lib", "advapi32.lib", "setupapi.lib", "shell32.lib", "cfgmgr32.lib"];
        for (var i = 0; i < libs.length; i++) CHECK_LIB(libs[i], "phpsdl");

        EXTENSION("phpsdl", "phpsdl.c render.c path.c raster.c", PHP_PHPSDL_SHARED, "/DZEND_ENABLE_STATIC_TSRMLS_CACHE=1");
        ADD_SOURCES(configure_module_dirname + "\\gl", "phpglfw_math.c phpglfw_buffer.c " +
            "phpglfw_texture.c phpglfw_audio.c", "phpsdl");
        var dirs = ["", "\\gl", "\\vendor\\cvector", "\\vendor\\stb", "\\vendor\\nanosvg\\src",
            "\\vendor\\miniaudio"];
        for (var j = 0; j < dirs.length; j++) ADD_FLAG("CFLAGS_PHPSDL", "/I" + configure_module_dirname + dirs[j]);
        AC_DEFINE("HAVE_PHPSDL", 1, "phpsdl support");
    } else {
        WARNING("phpsdl not enabled: SDL3 headers or library not found");
    }
}
